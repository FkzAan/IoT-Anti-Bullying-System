# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sentry_dashboard

# Admin bootstrap account (created automatically on first run if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# How many seconds without contact before a device is considered offline
DEVICE_OFFLINE_THRESHOLD_SECONDS=60

# Shared secret the ESP32 must send as the X-Device-Key header when POSTing
# an alert image to /api/devices/:id/alert. Leave blank to disable the check
# (not recommended outside local testing).
DEVICE_API_KEY=change-this-shared-secret
